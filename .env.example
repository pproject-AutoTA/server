# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 시크릿 값은 여기 적지 않는다.
# 기본값은 호스트(IntelliJ 등)에서 앱을 직접 실행하고 DB·RabbitMQ만 compose로 띄울 때 기준이다.
# 앱까지 compose 안에서 띄우면 compose 파일의 environment 에서 호스트를 서비스명(postgres, rabbitmq)으로 준다.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL (로컬 compose)
DB_URL=jdbc:postgresql://localhost:5432/autota
DB_USERNAME=
DB_PASSWORD=

# RabbitMQ (로컬 compose, 평문 5672. 운영은 K8s Secret 으로 EC2 주소와 AMQPS 5671)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# JWT (32자 이상 랜덤 문자열)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
