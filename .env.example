# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 시크릿 값은 여기 적지 않는다.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL (로컬 compose / Supabase)
DB_URL=jdbc:postgresql://localhost:5432/autota
DB_USERNAME=
DB_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
