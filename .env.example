# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 시크릿 값은 여기 적지 않는다.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL (로컬 compose / Supabase)
DB_URL=jdbc:postgresql://localhost:5432/autota
DB_USERNAME=
DB_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# CORS: 프론트 오리진(쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (32자 이상 랜덤 문자열)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
