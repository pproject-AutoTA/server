{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pproject-AutoTA/server/contracts/judge-result.schema.json",
  "title": "JudgeResult",
  "description": "judge-worker -> result.queue -> core-api. 전 케이스 실행 완료(DONE) 또는 마지막 시도 실패(FAILED).",
  "type": "object",
  "required": ["submissionId", "status", "attempt", "workerId", "judgedAt"],
  "properties": {
    "submissionId": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["DONE", "FAILED"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
    "workerId": { "type": "string" },
    "judgedAt": { "type": "string", "format": "date-time" },
    "verdict": {
      "type": "string",
      "enum": ["AC", "WA", "TLE", "MLE", "RE"],
      "description": "제출 전체 판정. 모두 AC면 AC, 아니면 no 순서로 처음 실패한 케이스의 verdict"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["no", "verdict"],
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "verdict": {
            "type": "string",
            "enum": ["AC", "WA", "TLE", "MLE", "RE", "SKIPPED"],
            "description": "SKIPPED는 앞 케이스에서 컨테이너가 죽어 실행하지 못한 케이스"
          },
          "cpuTimeMs": { "type": "integer", "minimum": 0, "description": "케이스 프로세스 CPU 시간(user+sys). SKIPPED면 생략" },
          "memoryKb": { "type": "integer", "minimum": 0, "description": "케이스 프로세스 최대 RSS. SKIPPED면 생략" },
          "actualOutput": { "type": "string", "maxLength": 1024, "description": "실제 출력 앞 1KB" }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["RUNNER_ERROR", "IMAGE_NOT_FOUND", "SCHEDULE_TIMEOUT", "INTERNAL"],
          "description": "RUNNER_ERROR: 컨테이너/Job 생성·실행 실패. IMAGE_NOT_FOUND: 채점 이미지 없음. SCHEDULE_TIMEOUT: Job이 제한 시간 안에 시작 못 함. INTERNAL: 그 외 워커 예외"
        },
        "message": { "type": "string", "maxLength": 2000, "description": "워커가 남긴 메시지. 관리자 실패 이력에 그대로 보인다" }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "status": { "const": "DONE" } },
      "required": ["verdict", "cases"],
      "not": { "required": ["error"] }
    },
    {
      "properties": { "status": { "const": "FAILED" } },
      "required": ["error"],
      "not": { "anyOf": [ { "required": ["verdict"] }, { "required": ["cases"] } ] }
    }
  ]
}
